---
import Layout from '../layouts/Layout.astro';
import { nowSnippet } from '../data/now.ts';

const updated = new Date(nowSnippet.lastUpdated);
const fmt = updated.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Layout
  title="Now — Hammadh Arquil"
  description="What I'm focused on right now. Updated periodically."
  file="about/now.md"
>
  <article class="now container-page">
    <header class="head">
      <p class="ws-cmd">cat about/now.md</p>
      <h1>What I'm focused on right now</h1>
      <p class="updated">Last updated <time datetime={nowSnippet.lastUpdated}>{fmt}</time></p>
    </header>

    <div class="prose">
      <p>
        I'm based in Colombo, Sri Lanka, juggling a few interconnected things —
        most days touch all of them.
      </p>

      <h2>Running Requester</h2>
      <p>
        <a href="https://www.getrequester.com" target="_blank" rel="noopener noreferrer">Requester</a>
        is the main thing on my desk: an AI-driven approval workflow SaaS I build
        solo. It's live and taking users now — which means the work has shifted
        from getting to launch to what comes after it: onboarding, the rough edges
        real teams find in the workflow generation loop, and watching how the
        seat-based pricing behaves with actual usage. It shipped under the name
        <em>Requset</em>; the old domain redirects.
      </p>

      <h2>Engineering at HT Works</h2>
      <p>
        I'm shipping cross-platform mobile and web work in Flutter and Angular at
        HT Works — the day-job that pays for the side projects and keeps me close
        to real users in healthcare.
      </p>

      <h2>Building on Prayr</h2>
      <p>
        <a href="https://prayr-app.com" target="_blank" rel="noopener noreferrer">Prayr</a>
        is back in active development. There's a batch of new features in progress
        and a full redesign planned — the current surface has outgrown the shape I
        first gave it, and the tracking loop deserves to be the thing you land on.
      </p>

      <h2>Open to consulting</h2>
      <p>
        If you're working on something interesting in healthcare, AI tooling, or
        SaaS infrastructure and need a senior eye, I'm taking on a small amount of
        short-engagement work. <a href="mailto:hammadharquil@gmail.com">Email me</a>.
      </p>
    </div>

    <p class="footer-note">
      This is a <a href="https://nownownow.com" target="_blank" rel="noopener noreferrer">/now page</a>,
      a snapshot of current focus. It changes when I do.
    </p>
  </article>
</Layout>

<style>
  .now {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 640px) {
    .now { padding-top: 3rem; }
  }
  .head { margin-bottom: 2rem; }
  .head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: var(--leading-display);
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }
  .updated {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-subtle);
    margin: 0.5rem 0 0;
  }
  .footer-note {
    color: var(--fg-subtle);
    font-size: 0.85rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .footer-note a { color: var(--fg-muted); text-decoration: underline; text-underline-offset: 2px; }
  .footer-note a:hover { color: var(--accent); }
</style>
