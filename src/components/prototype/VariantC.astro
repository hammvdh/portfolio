---
// PROTOTYPE — Variant C "Canvas": the designer framing. Artboards on a dotted canvas, a
// multiplayer-style cursor wandering between them, selection handles on hover.
import Demo from './Demo.astro';
import Timeline from './Timeline.astro';
const elite = Array.from({ length: 6 }, (_, i) => `/images/elitepsd/${String(i + 1).padStart(2, '0')}.png`);
---

<div class="vc" data-variant="C" hidden>
  <header class="vc-bar">
    <div class="vc-tools"><span class="vc-logo">H</span><span class="on">▲</span><span>#</span><span>T</span><span>✎</span></div>
    <div class="vc-file">Hammadh Arquil <span>/ hammadh.dev</span></div>
    <div class="vc-right">
      <span class="vc-av" title="Hammadh">HA</span><span class="vc-av you" title="You">You</span>
      <span class="vc-zoom">100%</span>
      <a class="vc-share" href="mailto:hammadharquil@gmail.com">Get in touch</a>
    </div>
  </header>

  <div class="vc-canvas" data-canvas>
    <div class="vc-cursor" data-cursor><svg viewBox="0 0 16 16" width="18" height="18"><path d="M1 1l5.5 14 2-6 6-2z" /></svg><span>Hammadh</span></div>

    <div class="vc-frame vc-hero" data-frame data-name="Identity" style="--d:0">
      <h1 class="vc-name">Hammadh <em>Arquil</em></h1>
      <p class="vc-role">Designer by origin. Engineer by trade. Founder by stubbornness.</p>
      <p class="vc-p">I run <a href="https://www.getrequester.com">Requester</a>, an AI approvals platform I build solo, and ship production work at <a href="https://htworkslk.com">HT Works</a>. Previously founding engineer at <a href="https://sunoanalytics.com">Suno Analytics</a>. On the side: <a href="https://prayr-app.com">Prayr</a>.</p>
      <p class="vc-meta">Colombo · <span data-clock-colombo>--:--</span> · <span data-tzdiff>—</span></p>
      <div class="vc-sticky">designing since 2016,<br />shipping since 2021 ✦</div>
    </div>

    <div class="vc-row">
      <div class="vc-frame tall" data-frame data-name="Requester / approvals" style="--d:1"><Demo kind="requester" shot="/images/projects/requester.png" /></div>
      <div class="vc-col">
        <div class="vc-frame" data-frame data-name="Prayr / day arc" style="--d:2"><Demo kind="prayr" shot="/images/projects/prayr.png" /></div>
        <div class="vc-frame" data-frame data-name="Vital / monitor" style="--d:3"><Demo kind="vital" shot="/images/projects/vital.png" /></div>
      </div>
    </div>
    <div class="vc-row r2">
      <div class="vc-frame" data-frame data-name="ONCO / scan" style="--d:4"><Demo kind="onco" shot="/images/projects/onco.png" /></div>
      <div class="vc-frame" data-frame data-name="Terminal / ship" style="--d:5"><Demo kind="terminal" /></div>
    </div>

    <div class="vc-frame wide" data-frame data-name="Changelog · 2016 → 2026" style="--d:6">
      <Timeline />
    </div>

    <div class="vc-frame wide vc-elite" data-frame data-name="ElitePSD archive" style="--d:7">
      {elite.map((src, i) => (
        <div class="vc-fill" style={`--r:${[-3, 2, -1, 3, -2, 1][i]}deg`}>
          <img src={src} alt="" loading="lazy" onerror="this.remove()" /><span>Image fill · {src.split('/').pop()}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .vc {
    --canvas: #efefec; --ink: #18181b; --mut: #75757c; --sel: #0d99ff; --acc: #5a8a1a;
    --d-bg: #ffffff; --d-fg: #18181b; --d-muted: #8b8b92; --d-line: #e6e6e3; --d-accent: #5a8a1a; --d-panel: #fafaf8;
    --t-bg: #fff; --t-fg: #18181b; --t-muted: #7b7b82; --t-line: #e6e6e3; --t-accent: #5a8a1a; --t-panel: #fff;
    background: var(--canvas); color: var(--ink); min-height: 100vh;
  }
  .vc a { color: inherit; text-decoration: underline; text-decoration-color: var(--sel); text-underline-offset: 3px; }

  .vc-bar { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 48px; padding: 0 10px; background: #2c2c2c; color: #fff; font-size: 13px; }
  .vc-tools { display: flex; gap: 2px; } .vc-tools span { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 6px; color: #ccc; font-size: 12px; }
  .vc-tools span.on { background: var(--sel); color: #fff; } .vc-logo { font-weight: 700; color: #fff !important; }
  .vc-file span { color: #9a9a9a; }
  .vc-right { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }
  .vc-av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font: 600 9.5px var(--f-sans); background: #f24e1e; }
  .vc-av.you { background: #9747ff; margin-left: -14px; border: 2px solid #2c2c2c; }
  .vc-zoom { color: #ccc; font-size: 12px; padding: 0 6px; }
  .vc-share { background: var(--sel); color: #fff !important; text-decoration: none !important; padding: 6px 12px; border-radius: 6px; font-weight: 500; }

  .vc-canvas {
    position: relative; padding: 70px clamp(16px, 5vw, 72px) 120px; max-width: 1240px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 64px;
  }
  .vc::before { content: ''; position: fixed; inset: 0; background-image: radial-gradient(#c9c9c4 1px, transparent 1px); background-size: 20px 20px; pointer-events: none; }
  .vc > * { position: relative; }

  .vc-frame { position: relative; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 12px 32px -18px rgba(0,0,0,.25); min-height: 260px; }
  .vc-frame::before { content: attr(data-name); position: absolute; top: -20px; left: 0; font: 500 11px var(--f-sans); color: var(--mut); white-space: nowrap; }
  .vc-frame::after { content: ''; position: absolute; inset: -1px; border: 1.5px solid var(--sel); opacity: 0; pointer-events: none; transition: opacity .15s;
    background:
      linear-gradient(#fff, #fff) top left / 7px 7px no-repeat, linear-gradient(#fff, #fff) top right / 7px 7px no-repeat,
      linear-gradient(#fff, #fff) bottom left / 7px 7px no-repeat, linear-gradient(#fff, #fff) bottom right / 7px 7px no-repeat;
    outline: 0; }
  .vc-frame:hover::after, .vc-frame.sel::after { opacity: 1; }
  .vc-frame:hover::before, .vc-frame.sel::before { color: var(--sel); }
  .vc-frame :global(.demo) { position: absolute; inset: 0; }
  .vc-frame.in { animation: vc-in .6s cubic-bezier(.16,1,.3,1) both; animation-delay: calc(var(--d) * 90ms); }
  @keyframes vc-in { from { opacity: 0; transform: translateY(14px) scale(.985); } }

  .vc-hero { padding: clamp(28px, 5vw, 64px); min-height: 0; max-width: 820px; }
  .vc-name { font-size: clamp(46px, 8vw, 96px); line-height: .95; letter-spacing: -.05em; margin: 0; font-weight: 600; }
  .vc-name em { font-family: var(--f-serif); font-weight: 400; letter-spacing: -.02em; }
  .vc-role { font-size: 19px; color: var(--mut); margin: 18px 0 26px; }
  .vc-p { font-size: 17px; line-height: 1.65; max-width: 560px; margin: 0 0 20px; }
  .vc-meta { font: 500 12px var(--f-mono); color: var(--mut); margin: 0; }
  .vc-sticky { position: absolute; right: -36px; bottom: -30px; width: 170px; padding: 14px; background: #fff3b0; font: 400 19px/1.2 'Caveat', cursive; transform: rotate(4deg); box-shadow: 0 10px 20px -12px rgba(0,0,0,.35); }

  .vc-row { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; margin-left: clamp(0px, 8vw, 120px); }
  .vc-row.r2 { grid-template-columns: 1fr 1.2fr; margin-left: 0; margin-right: clamp(0px, 6vw, 90px); }
  .vc-col { display: flex; flex-direction: column; gap: 40px; }
  .vc-col .vc-frame { flex: 1; }
  .vc-frame.tall { min-height: 560px; }
  .vc-frame.wide { min-height: 0; padding: 0; }
  .vc-frame.wide :global(.tl) { border: 0; border-radius: 0; }

  .vc-elite { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; padding: 28px !important; background: #f6f6f3; }
  .vc-fill { aspect-ratio: 3/4; position: relative; background: repeating-conic-gradient(#e8e8e4 0 25%, #f3f3f0 0 50%) 0 0 / 14px 14px; transform: rotate(var(--r)); transition: transform .35s cubic-bezier(.16,1,.3,1); }
  .vc-fill:hover { transform: rotate(0) translateY(-6px); }
  .vc-fill img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vc-fill span { position: absolute; bottom: -18px; left: 0; font: 400 10px var(--f-sans); color: var(--mut); white-space: nowrap; }

  .vc-cursor { position: absolute; z-index: 10; left: 0; top: 0; pointer-events: none; transition: transform 1.1s cubic-bezier(.65,0,.35,1); display: flex; align-items: flex-start; }
  .vc-cursor svg path { fill: #f24e1e; stroke: #fff; stroke-width: 1.2; }
  .vc-cursor span { margin: 14px 0 0 -2px; background: #f24e1e; color: #fff; font: 500 11px var(--f-sans); padding: 3px 7px; border-radius: 4px 10px 10px 10px; }

  @media (max-width: 820px) {
    .vc-row, .vc-row.r2 { grid-template-columns: 1fr; margin: 0; }
    .vc-frame.tall { min-height: 380px; } .vc-elite { grid-template-columns: repeat(3, 1fr); }
    .vc-sticky { right: 8px; bottom: -40px; } .vc-file span, .vc-zoom { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.vc')!;
  const canvas = root.querySelector<HTMLElement>('[data-canvas]')!, cursor = root.querySelector<HTMLElement>('[data-cursor]')!;
  const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let wanderT: number | undefined;

  // Fake collaborator: wanders to a visible frame, "selects" it, moves on.
  function wander() {
    clearTimeout(wanderT);
    const vis = frames.filter((f) => { const r = f.getBoundingClientRect(); return r.bottom > 80 && r.top < innerHeight - 40; });
    const f = vis[Math.floor(Math.random() * vis.length)];
    if (f) {
      const c = canvas.getBoundingClientRect(), r = f.getBoundingClientRect();
      const x = r.left - c.left + r.width * (0.3 + Math.random() * 0.5), y = r.top - c.top + r.height * (0.25 + Math.random() * 0.5);
      cursor.style.transform = `translate(${x}px, ${y}px)`;
      wanderT = window.setTimeout(() => {
        frames.forEach((x) => x.classList.toggle('sel', x === f));
        wanderT = window.setTimeout(() => { f.classList.remove('sel'); wander(); }, 1500);
      }, 1150);
    } else wanderT = window.setTimeout(wander, 800);
  }

  function intro() {
    frames.forEach((f) => { f.classList.remove('in'); void f.offsetWidth; if (!reduce) f.classList.add('in'); });
    if (!reduce) wanderT = window.setTimeout(wander, 900);
  }
  addEventListener('variant:show', (e) => { if ((e as CustomEvent).detail === 'C') intro(); else clearTimeout(wanderT); });
  if (document.documentElement.dataset.activeVariant === 'C') intro();
</script>
